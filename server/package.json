{
  "name": "pinkpitch-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PinkPitch – Football Jersey Store REST API (Express + PostgreSQL / pgAdmin)",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/initDb.js",
    "db:schema": "node scripts/runSql.js database/schema.sql",
    "db:seed": "node scripts/runSql.js database/seed.sql",
    "db:setup": "npm run db:schema && npm run db:seed",
    "db:admin": "node scripts/createAdmin.js",
    "db:demo": "node scripts/createDemoUser.js",
    "test": "node --test --test-concurrency=1 --test-timeout=60000"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
